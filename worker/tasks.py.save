import logging

from arq import create_pool
from arq.connections import RedisSettings

from app.config import settings
from core import outbox

logger = logging.getLogger(__name__)


async def ping(ctx, message: str = "pong") -> str:
    """Тестовая задача."""
    logger.info("ping task received: %s", message)
    return message


async def publish_pending(ctx) -> int:
    """Издатель: читает pending из outbox и кладёт в Redis."""
    tasks = await outbox.fetch_pending(limit=100)
    if not tasks:
        return 0

    redis = await create_pool(RedisSettings.from_dsn(settings.redis_url))
    published = 0
    for task in tasks:
        try:
            await redis.enqueue_job(
                "process_outbox_task",
                str(task.id),
                task.payload,
                _job_id=str(task.id),  # идемпотентность в Redis
            )
            await outbox.mark_enqueued(task.id)
            published += 1
            logger.info("outbox: enqueued task %s", task.id)
        except Exception as e:
            logger.warning("outbox: failed to enqueue task %s: %s", task.id, e)
    await redis.close()
    return published


